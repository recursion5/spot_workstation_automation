# Copy to .env (gitignored) on the controller. Never commit real values.

SPOT_WINRM_HOST=
SPOT_WINRM_USER=
SPOT_WINRM_PASSWORD=
SPOT_WINRM_TRANSPORT=ntlm
SPOT_WINRM_PORT=5985
SPOT_WINRM_SCHEME=http

# Optional firewall restriction used by Bootstrap-WinRM.ps1
SPOT_CONTROLLER_CIDR=10.0.253.225/32

# Evidence output on the controller (outside git)
SPOT_EVIDENCE_ROOT=/home/grok-agent/spot-discovery/evidence

# NAS rebuild pack (never commit the password)
SPOT_NAS_SHARE=//zenith-dsm.vogueclean.int/spot-rebuild
SPOT_NAS_USER=spot-rebuild
SPOT_NAS_PASSWORD=
