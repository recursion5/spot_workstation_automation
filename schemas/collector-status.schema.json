{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.spot-discovery/schemas/collector-status.json",
  "title": "Collector status",
  "type": "object",
  "required": [
    "collector",
    "version",
    "run_id",
    "started_at",
    "ended_at",
    "status",
    "output_files",
    "warnings"
  ],
  "properties": {
    "collector": { "type": "string", "minLength": 1 },
    "version": { "type": "string" },
    "run_id": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string" },
    "ended_at": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["success", "failed", "skipped", "partial"]
    },
    "output_files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "error": { "type": "string" }
  },
  "additionalProperties": true
}
